# =============================================================================
# Modular RAG MCP Server — 环境变量配置
# =============================================================================
# 复制此文件为 .env 并填入你的 API Key
# cp .env.example .env
# =============================================================================

# OpenAI / Azure OpenAI API Key（settings.yaml 中填 __OPENAI_API_KEY__ 时自动读取此变量）
OPENAI_API_KEY=sk-your-key-here

# Secret Key for JWT (generate a random string)
SECRET_KEY=your-secret-key-here

# Tushare API Token（A 股主数据源）
# 申请: https://tushare.pro
TUSHARE_API_TOKEN=your-tushare-token-here

# Tavily Search API Key（联网搜索，可选）
# 申请: https://app.tavily.com (1000次/月免费)
TAVILY_API_KEY=your-tavily-key-here
